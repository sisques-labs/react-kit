{
  "name": "@sisques-labs/react-kit",
  "version": "1.0.0-beta.1",
  "description": "React/Next.js Kit with framework-agnostic domain utilities, a shadcn/Radix component catalog, and Next.js-specific helpers shared across Sisques Labs frontends",
  "author": "JSisques",
  "private": false,
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./ui": {
      "require": "./dist/entrypoints/ui.js",
      "import": "./dist/entrypoints/ui.js",
      "types": "./dist/entrypoints/ui.d.ts"
    },
    "./next": {
      "require": "./dist/entrypoints/next.js",
      "import": "./dist/entrypoints/next.js",
      "types": "./dist/entrypoints/next.d.ts"
    },
    "./http": {
      "require": "./dist/entrypoints/http.js",
      "import": "./dist/entrypoints/http.js",
      "types": "./dist/entrypoints/http.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "husky && pnpm run build",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.tsc-alias.json && node -e \"if (!require('fs').existsSync('dist/index.js')) { console.error('build failed: dist/index.js was not emitted'); process.exit(1); }\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "lint:check": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed",
    "test:cov": "vitest run --coverage",
    "prepublishOnly": "npm run build",
    "release": "semantic-release"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": "eslint --fix"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "next": ">=14.0.0",
    "@radix-ui/react-avatar": ">=1.2.0",
    "@radix-ui/react-checkbox": ">=1.3.0",
    "@radix-ui/react-context-menu": ">=2.3.0",
    "@radix-ui/react-dialog": ">=1.1.0",
    "@radix-ui/react-dropdown-menu": ">=2.1.0",
    "@radix-ui/react-label": ">=2.1.0",
    "@radix-ui/react-popover": ">=1.1.0",
    "@radix-ui/react-radio-group": ">=1.4.0",
    "@radix-ui/react-select": ">=2.3.0",
    "@radix-ui/react-slot": ">=1.3.0",
    "@radix-ui/react-switch": ">=1.3.0",
    "@radix-ui/react-tabs": ">=1.1.0",
    "@radix-ui/react-tooltip": ">=1.2.0",
    "lucide-react": ">=1.24.0",
    "class-variance-authority": ">=0.7.0",
    "clsx": ">=2.1.0",
    "tailwind-merge": ">=3.6.0",
    "cmdk": ">=1.1.0",
    "@tanstack/react-table": ">=8.21.0",
